{
  "name": "@foliag/bloom",
  "version": "0.1.0",
  "description": "Styled Solid 2 components for generic products",
  "keywords": [
    "solid",
    "components",
    "ui",
    "styled"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foli-ag/bloom.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "skills"
  ],
  "exports": {
    "./button": {
      "types": "./dist/button/index.d.ts",
      "default": "./dist/button/index.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox/index.d.ts",
      "default": "./dist/checkbox/index.js"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "default": "./dist/input/index.js"
    },
    "./radio-group": {
      "types": "./dist/radio-group/index.d.ts",
      "default": "./dist/radio-group/index.js"
    },
    "./slider": {
      "types": "./dist/slider/index.d.ts",
      "default": "./dist/slider/index.js"
    },
    "./switch": {
      "types": "./dist/switch/index.d.ts",
      "default": "./dist/switch/index.js"
    },
    "./toggle-group": {
      "types": "./dist/toggle-group/index.d.ts",
      "default": "./dist/toggle-group/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/theme.css src/fonts.css dist/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "biome format --write .",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@foliag/seeds": "^0.2.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.9",
    "solid-js": "^2.0.0-rc.9",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.44",
    "@solidjs/web": "2.0.0-rc.9",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "25.9.5",
    "@vitest/browser-playwright": "4.1.11",
    "playwright": "1.63.0",
    "solid-js": "2.0.0-rc.9",
    "storybook": "10.6.1",
    "storybook-dark-mode": "5.0.0",
    "storybook-solidjs-vite": "10.7.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite-plugin-solid": "npm:@solidjs/vite-plugin@3.0.0-next.44",
    "@solidjs/signals": "2.0.0-rc.9",
    "@solidjs/compiler": "2.0.0-rc.9",
    "@solidjs/babel-plugin": "2.0.0-rc.9"
  }
}
