{
  // One module per source file, so that the app's bundler drops the parts and components it does not use
  "extends": "./tsconfig.json",
  "include": ["src"],
  // Stories are for Storybook and the test run, not for the package
  "exclude": ["src/**/*.stories.tsx"],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,
    "types": []
  }
}
